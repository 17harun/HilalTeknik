# ==================== HİLAL TEKNİK — APACHE YAPILANDIRMASI ====================
# Statik site. Yalnızca paylaşımlı hostinglerde .htaccess içinde izin verilen
# direktifler kullanılır (mod_security / mod_evasive / PHP ayarları 500 hatasına yol açabildiği için yoktur).

# ---------- Temel ----------
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
AddDefaultCharset utf-8

# ---------- MIME türleri (eski Apache sürümleri AVIF/WebP'yi tanımaz) ----------
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType text/javascript .js
    AddType image/svg+xml .svg
</IfModule>

# ---------- Güvenlik başlıkları ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdnjs.cloudflare.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://*.clarity.ms https://c.bing.com; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always unset X-Powered-By

    # Önbellek: HTML her zaman güncel; CSS/JS sürüm parametreli (?v=) olduğu için 1 yıl; görseller 30 gün
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ---------- Erişim kısıtlamaları ----------
# Yapılandırma / kaynak / sistem dosyaları tarayıcıdan okunamaz
<FilesMatch "(^\.|\.(htaccess|htpasswd|ini|log|sh|bak|sql|db|env|md|yml|yaml|toml|json|lock|map)$|^(_headers|_redirects)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Gizli dosya/dizinler (.git, .env ...) engellenir; SSL doğrulaması için .well-known serbest
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # Şüpheli sorgu dizeleri (path traversal / script enjeksiyonu denemeleri)
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|<script|%3Cscript|base64_|GLOBALS|_REQUEST|_ENV) [NC]
    RewriteRule .* - [F,L]

    # HTTP -> HTTPS (yerel geliştirme hariç)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # www -> www'suz kanonik adres
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Görsel hotlink koruması (boş referer, kendi alan adları ve arama motorları serbest)
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?(hilalteknik\.com|hilalsihhitesisat\.com) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:\d+)? [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?(google|bing|yandex|facebook|instagram|whatsapp)\. [NC]
    RewriteRule \.(jpe?g|png|gif|webp|avif)$ - [F,NC,L]
</IfModule>

# ---------- Sıkıştırma ----------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Tarayıcı önbelleği (mod_headers yoksa yedek) ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
